{
  "name": "@ez1/typescript-sdk",
  "version": "2.0.0",
  "description": "Official TypeScript SDK for EasyOne API with client-side encryption",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "tsx --test",
    "test:unit": "tsx --test --test-name-pattern=^unit",
    "test:integration": "tsx --test --test-name-pattern=^integration",
    "test:coverage": "tsx --test --test-name-pattern=^unit --experimental-test-coverage",
    "test:watch": "tsx --test --watch"
  },
  "keywords": [
    "ez1",
    "easyone",
    "file-upload",
    "encryption",
    "aes-gcm",
    "storage",
    "sdk"
  ],
  "author": "ez1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ez1-cc/typescript-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/ez1-cc/typescript-sdk/issues"
  },
  "homepage": "https://github.com/ez1-cc/typescript-sdk#readme",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "dotenv": "^16.3.1",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
